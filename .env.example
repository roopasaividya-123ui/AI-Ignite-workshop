# ─────────────────────────────────────────────────────────────────
#  OpportunityOS — Environment Configuration Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Database connection URL.
# SQLite (development):  sqlite:///./data/opportunityos.db
# PostgreSQL (production): postgresql://user:password@host:5432/opportunityos
DATABASE_URL=sqlite:///./data/opportunityos.db

# Secret key used to sign JWT tokens.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-key

# JWT access token lifetime (minutes). Default: 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secret required to register an admin account.
# Keep this out of logs and responses. Do not hardcode.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_SECRET=replace-this-with-a-strong-admin-registration-secret

